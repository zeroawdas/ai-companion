# ── 对话（DeepSeek，必填）───────────────────────────────
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_API_BASE=https://api.deepseek.com

# ── 联网搜索（博查 Bocha，可选）────────────────────────
